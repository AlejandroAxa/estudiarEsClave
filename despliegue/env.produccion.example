# Claves del sitio en el VPS. Se copia a .env en la carpeta del proyecto (o se crea
# con: sh despliegue/crear-env.sh). Nunca subas .env al repositorio.

# Para que «docker compose …» use siempre el archivo de producción.
COMPOSE_FILE=compose.produccion.yml

# ── Dominio ──
# Sin https:// ni diagonal. Caddy pide el certificado para este dominio y para www.
DOMINIO=

# ── Base de datos (Postgres en el mismo VPS) ──
# Solo letras y números. Genera una con: openssl rand -hex 24
POSTGRES_PASSWORD=
# Días de respaldos que se guardan en ./respaldos
DIAS_RESPALDO=14

# ── Sesión ──
# Genera uno con: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Entrar con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Administración ──
# Correos que reciben el rol de administrador al registrarse, separados por coma
ADMIN_EMAILS=
# Segundo factor del panel (base32). crear-env.sh lo genera
ADMIN_TOTP_SECRET=

# ── Correo (Resend, https://resend.com). Obligatorio: sin él nadie puede entrar ──
RESEND_API_KEY=
CORREO_REMITENTE="Estudiar es Clave <hola@tu-dominio.mx>"

# ── Pagos (Mercado Pago) ──
PASARELA=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Tareas programadas. Genera uno con: openssl rand -hex 24 ──
CRON_SECRET=
