# Proxy inverso con HTTPS automático (Let's Encrypt). Caddy pide y renueva el
# certificado solo, en cuanto el dominio apunta a la IP del VPS.
#
# Detrás de Cloudflare (guía, paso 12) todas las peticiones llegan desde IP de
# Cloudflare. Para que los límites de uso sigan siendo por alumno, la IP real se
# toma de CF-Connecting-IP, pero solo si la petición viene de una IP de
# Cloudflare; si llega de cualquier otro lado, ese encabezado se ignora.
# Lista oficial: https://www.cloudflare.com/ips/ (revísala una vez al año).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMINIO} {
	encode zstd gzip
	reverse_proxy web:3000 {
		# El sitio toma la IP del alumno de aquí para los límites de uso;
		# se reescribe siempre para que nadie la pueda falsificar.
		header_up X-Real-IP {client_ip}
	}
}

www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}
