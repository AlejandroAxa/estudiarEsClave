# Copia este archivo a .env.local y llénalo. Nunca subas .env.local al repositorio.

# ── Base de datos ──
# Neon (Vercel Marketplace) la pone sola. Para probar sin servidor: pglite:./.datos-local
DATABASE_URL=

# ── Sesión (Better Auth) ──
# Genera uno con: openssl rand -hex 32
BETTER_AUTH_SECRET=
# URL pública del sitio, sin diagonal final. En local: http://localhost:3000
BETTER_AUTH_URL=

# Entrar con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Administración ──
# Correos que reciben el rol de administrador al registrarse, separados por coma
ADMIN_EMAILS=
# Segundo factor del panel. Genera uno con: npm run admin:totp
ADMIN_TOTP_SECRET=

# ── Correo (Resend). Sin clave, los enlaces de acceso se imprimen en la consola ──
RESEND_API_KEY=
CORREO_REMITENTE="Estudiar es Clave <hola@tu-dominio.mx>"

# ── Pagos ──
# mercadopago en producción; simulada solo para desarrollo (se rechaza en producción)
PASARELA=simulada
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de la notificación (webhook) en el panel de Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=

# ── Límites de uso (Upstash Redis, Vercel Marketplace). Sin ellos se usa memoria local ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (la integración de Vercel también puede ponerlas como KV_REST_API_URL y KV_REST_API_TOKEN)

# ── Imágenes compartidas (Vercel Blob, opcional) ──
BLOB_READ_WRITE_TOKEN=

# ── Tareas programadas. Vercel Cron manda este secreto ──
CRON_SECRET=

# Solo para db:sembrar: fecha de examen de prueba (AAAA-MM-DD)
FECHA_EXAMEN_DEMO=
